%
% Station blanche : ajoute au compte admin créé par dev_workstation un compte
% générique pour les employés (sans sudo), ClamAV et les mises à jour de
% sécurité automatiques.

loaf 0.1.
use hamac 0.2.

bundle white_station {
  version "0.1.0".
  description "Station blanche : compte générique employés (sans sudo) + ClamAV + unattended-upgrades".

  depends_on dev_workstation.

  % Nom du compte générique, ex. "OCamlPro".
  param generic_username {
    type string.
    required.
  }

  % Mot de passe initial du compte générique, expiré au premier login.
  param generic_password { type string. }

  % Installer ClamAV (clamav-daemon + freshclam) et activer les mises à
  % jour de sécurité automatiques.
  param hardening { type bool. }
}
