{# Bundle server_base — variante Debian (cloud-init Jinja2).
   Un template par famille d'OS : cloud-init.<family>.yaml.j2.
   Params : username (req), full_name, ssh_public_keys, initial_password,
   timezone. Au moins ssh_public_keys OU initial_password doit être fourni. #}

users:
  - name: {{ params.username }}
    gecos: "{{ params.full_name | default(params.username) }}"
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    groups: sudo
{% if params.initial_password %}
    lock_passwd: false
    plain_text_passwd: {{ params.initial_password }}
{% else %}
    lock_passwd: true
{% endif %}
{% if params.ssh_public_keys %}
    ssh_authorized_keys:
{% for key in params.ssh_public_keys %}
      - {{ key }}
{% endfor %}
{% endif %}

{% if params.initial_password %}
chpasswd:
  expire: true
{% endif %}

{% if params.timezone %}
timezone: {{ params.timezone }}
{% endif %}

package_update: true
packages:
  - git
  - vim
  - curl
  - ca-certificates
  - sudo
  - openssh-server
  - htop
  - jq
  - rsync

runcmd:
  - systemctl enable --now ssh || systemctl enable --now sshd
  - echo "hamac server_base provisioning done"
