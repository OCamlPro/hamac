;; Écrit à la main : marmiton ne génère que les tests cram de ses
;; exécutables (tests/<paquet>/dune).

;; Manifestes LOAF : validation des exemples par hamac, valeurs Types que le
;; chargeur en construit, et sorties figées des commandes.
(executable
 (name show)
 (libraries hamac-manifest))

(cram
 (deps
  %{bin:hamac}
  show.exe
  (package hamac-manifest)
  (glob_files_rec %{project_root}/examples/**)
  (glob_files_rec %{project_root}/patterns/**)
  (glob_files_rec %{project_root}/providers/**)
  (glob_files_rec %{project_root}/provisioning-profiles/**)
  (glob_files_rec %{project_root}/templates/bundles/**))
 (package hamac))
