loaf 0.1.
use hamac 0.2.

infrastructure lab {
  backend docker_compose.
  allow internal, public, analytics, web_api.
  deny public, secure.
  deny_reason public, secure, "no read up".
}

% Les services que nomment les règles de filtrage.
service analytics { runtime eventloop. }
service web_api { runtime http. }
