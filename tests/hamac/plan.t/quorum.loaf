loaf 0.1.
use hamac 0.2.

% Un service à état sur trois domaines de panne au moins : db n'a que deux
% répliques.
pattern p {
  zone a {}
  constraint stateful_quorum {}
}

service db {
  runtime http.
  zone a.
  replicas 2.
  storage data {
    mount "/var/lib/db".
    class replicated.
    size 1, gi.
  }
}
