loaf 0.1.
use hamac 0.2.
use hamac_ha 0.2.

% La même exigence, en préférence : le plan se fait, avec un avertissement.
pattern p {
  zone a {}
  ha::prefer_stateful_domains 2.
}

service db {
  runtime http.
  zone a.
  storage data {
    mount "/var/lib/db".
    class replicated.
    size 1, gi.
  }
}
