%
% Le patron de l'organisation : il déclare les rôles qu'elle attribue, et
% charge le patron hamac_default, dont il garde les niveaux et les zones.

loaf 0.1.
module organisation 1.0.0.
use hamac 0.2.
use hamac_rbac 0.2.
use hamac_default 0.2.

pattern organisation {
  rbac::role comptable; admin.
}
