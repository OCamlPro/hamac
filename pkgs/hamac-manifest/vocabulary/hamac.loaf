% SPDX-License-Identifier: AGPL-3.0-only
% Copyright (C) 2026 OCamlPro <contact@ocamlpro.com>
%
% Vocabulaire de Hamac : les blocs des six sortes de manifestes (service,
% pattern, stack, infrastructure, provisioning_profile, bundle), les contrats
% des capacités (database, cache), leurs énumérations, les termes que Hamac
% rend au déploiement, et les règles qui complètent le format. Un manifeste
% le charge par « use hamac 0.2. ».
%
% Conventions :
% - le nom d'un manifeste est le sujet de son bloc, une constante LOAF,
%   employée telle quelle ; seul un nom d'hôte remplace « _ » par « - » ;
% - un champ à plusieurs valeurs porte un nom au singulier : chaque
%   instruction en donne une (port 8080 { … }, secret session_key { … }) ;
% - un objet unique est un sous-bloc quand il a un identifiant naturel, qui
%   en est le sujet (artifact, health_check, metrics, backup, os) ; sinon
%   ses champs sont ceux du bloc qui le contient (ressources, placement,
%   sécurité, mise à l'échelle…), préfixés quand leur nom serait ambigu ;
% - les valeurs des énumérations s'écrivent avec « _ » là où le nom usuel
%   porte « - » (measured_tpm2, oci_image) ;
% - une quantité est un couple (entier, unité) : 512, mi pour 512 Mio ; les
%   délais des sondes (health_check, readiness) sont des entiers en
%   secondes ;
% - un champ absent prend la valeur par défaut indiquée en commentaire, que
%   Hamac applique.

loaf 0.1.
module hamac 0.2.0.

% ---------------------------------------------------------------------
% Service
% ---------------------------------------------------------------------

block service {
  % Métadonnées, communes à toutes les sortes de manifestes.
  description? string.
  label* string => string.       % clés courtes, pour les sélecteurs
  annotation* string => string.  % texte libre, ignoré par Hamac

  runtime runtime.
  artifact? string {  % sujet : chemin ou image de l'artefact
    sha256 string.
    format artifact_format.
    arch* arch.       % architectures où il s'exécute ; défaut amd64
  }
  replicas? int.      % défaut 1

  % Provider : la capacité fournie, dont il remplit le contrat (le bloc de
  % même nom, sous son nom : database postgresql { … }), et les valeurs
  % propres à chaque instance (une instance par consommation).
  capability? name.
  input* name => text.
  readiness* [text].        % commande de disponibilité
  readiness_interval? int.  % défaut 5
  readiness_timeout? int.   % défaut 30

  % Dépendances envers une capacité ou un autre service de la stack.
  consumes* name {
    capability? name.
    service? service.
    inject* string => text.     % variable d'environnement du consommateur
    mode? consume_mode.         % défaut request
    derived provider? service.  % le service retenu, calculé par Hamac
    % Ce que lisent les gabarits : le provider retenu, vu comme le contrat
    % de la capacité consommée ({~.database.user}) ; pour un service de la
    % stack, son point d'accès ({~.host}:{~.port}).
    derived database? database.
    derived cache? cache.
    derived host? text.         % nom d'hôte du service consommé
    derived port? int.          % son premier port
  }

  % Sécurité : la zone du service et ses routes. Les conditions d'accès à
  % une route sont des champs qu'ajoutent les modèles de sécurité
  % (blp::classification, rbac::role…).
  zone? name.                  % une zone des patrons ; défaut default
  route* string {
    method* string.            % aucun : toutes les méthodes
    public.                    % aucun jeton exigé
  }

  port* int {                 % sujet : port écouté par le service
    protocol? port_protocol.  % défaut tcp
  }
  environment* string => text.

  % Ressources.
  memory_request? int, size_unit.
  memory_limit? int, size_unit.
  cpu_request? int, cpu_unit.
  cpu_limit? int, cpu_unit.

  % Mise à l'échelle : min_replicas et max_replicas vont ensemble.
  min_replicas? int.
  max_replicas? int.
  cpu_threshold? int.     % en %
  memory_threshold? int.  % en %

  health_check? string {   % sujet : chemin HTTP de la sonde
    interval? int.         % défaut 30
    timeout? int.          % défaut 5
    retries? int.          % défaut 3
  }
  metrics? metrics_provider {
    path string.
    port? int.
  }
  log_format? log_format.  % défaut text
  log_level? name.         % défaut info

  storage* name {
    mount string.             % chemin absolu
    class storage_class.
    size? int, size_unit.     % requis hors ephemeral
    rebuild? rebuild.
  }
  backup? string {            % sujet : planification cron
    retention* retention_period => int.
    pre* [string].            % commandes de cohérence, avant
    post* [string].           % et après la sauvegarde
    verify? verify.           % défaut none
  }
  secret* name {
    ref? string.              % <backend>:<chemin>[#<clé>]
    generate? gen_kind, int.  % sorte de caractères, longueur
    rotate? int, time_unit.
    as? secret_as.            % défaut env
  }

  % Placement.
  need* name.                          % capacités que le nœud doit offrir
  spread? spread.                      % défaut none
  affinity* service.
  anti_affinity* service.

  exposure* string {              % sujet : nom d'hôte public
    path_prefix? string.          % défaut /
    port int.                     % un port déclaré par port
    protocol? exposure_protocol.  % défaut http
    tls? tls.                     % défaut acme
  }
}

enum runtime { http; cli; batch; eventloop; custom }.
enum artifact_format { oci_image; native; incus_vm_image; incus_system_image }.
enum arch { amd64; arm64 }.
enum consume_mode { request; push }.
enum port_protocol { tcp; udp }.
enum exposure_protocol { http; tcp }.
enum tls { acme; internal; passthrough }.
enum metrics_provider { prometheus }.
enum log_format { json; text }.
enum storage_class { ephemeral; local; replicated }.
enum rebuild { from_backup; from_object; from_replica; none }.
enum retention_period { hourly; daily; weekly; monthly; yearly }.
enum verify { none; restore_test }.
enum gen_kind { alpha; alnum }.
enum secret_as { env; file }.
enum spread { none; host; failure_domain }.

% Unités : octets (Ki, Mi, Gi, Ti), cœurs ou millicœurs, durées.
enum size_unit { ki; mi; gi; ti }.
enum cpu_unit { core; m }.
enum time_unit { s; min; h; d }.

% Axes d'assurance, et leurs niveaux du plus faible au plus fort.
enum axis { boot; operator; physical }.
enum assurance_level(boot) {
  none;
  provider_vtpm;
  confidential_vm;
  measured_tpm2
}.
enum assurance_level(operator) { any; eu; secnumcloud; self }.
enum assurance_level(physical) { third_party; dedicated_rack; site }.

% Termes que Hamac rend au déploiement. Ils restent opaques dans les
% règles et peuvent remplir un gabarit.
render gen(gen_kind, int).  % valeur aléatoire : gen(alnum, 32)
render input(name).         % valeur d'une entrée de l'instance du provider
render consumer(name).      % attribut du consommateur : consumer(name)
render instance(name).      % attribut de l'instance : instance(name)
render host(service).       % nom d'hôte d'un service
render secret(name).        % valeur d'un secret déclaré du service

% ---------------------------------------------------------------------
% Capacités
% ---------------------------------------------------------------------

% Le contrat d'une capacité : les attributs qu'en offre tout provider, que
% les gabarits des consommateurs lisent ({~.user}). Le sujet est le
% provider, qui remplit le bloc de sa capacité sous son nom :
%   database postgresql { user input(user). … }

block database {
  host text.
  port int.
  user text.
  password text.
  dbname text.
}

block cache {
  host text.
  port int.
  password text.
}

% ---------------------------------------------------------------------
% Pattern
% ---------------------------------------------------------------------

block pattern {
  description? string.
  label* string => string.
  annotation* string => string.

  % Un patron est le bloc d'un module (« module exemple_rh 1.0.0. »), qui
  % en porte la version ; la stack le charge par « use exemple_rh 1.0. »,
  % un patron qui en complète un autre charge le module de celui-ci. Le
  % patron charge aussi les modèles de sécurité qu'il emploie (use
  % hamac_blp 0.2.), qui ajoutent leurs champs aux zones et aux routes et
  % définissent zone_leq.

  % Les zones. Leurs étiquettes, leurs enclaves viennent des modèles de
  % sécurité que charge le patron.
  zone* name {}
  % Plancher d'assurance d'une zone, pour un patron qui doit répondre à une
  % exigence (hébergement certifié, hygiène renforcée…) : zone, axe =>
  % niveau minimal. Sans plancher, Hamac place chaque zone sur les machines
  % les plus sûres disponibles, les plus sensibles d'abord.
  assurance* name, axis => assurance_level.

}


% L'ordre des zones : zone_leq(A, B), un service de la zone B peut lire
% (ouvrir une connexion vers) la zone A. Chaque zone se lit elle-même ; le
% reste vient des modèles de sécurité que chargent les patrons.
predicate zone_leq(name, name).

% Les primitives de placement : ce que le planificateur sait respecter. Les
% champs du vocabulaire et les modules (hamac_ha…) s'y ramènent ; les
% manifestes ne les écrivent pas d'ordinaire. Une primitive « prefer_ » est
% une préférence : le planificateur la respecte s'il le peut, avant de
% réduire le nombre de nœuds.
predicate separate(service, service).         % jamais sur une même machine
predicate prefer_separate(service, service).
predicate min_domains(service, int).          % sur au moins N domaines de panne
predicate prefer_min_domains(service, int).
predicate floor(name, axis, assurance_level). % plancher d'assurance d'une zone

% Une enclave : une zone derrière une diode, qui ne laisse passer les
% données que vers elle, et qui a son propre plan de contrôle. Les modèles
% de sécurité la déduisent de leur politique (blp::enclave_from…).
predicate enclave(name).

% ---------------------------------------------------------------------
% Stack
% ---------------------------------------------------------------------

block stack {
  description? string.
  label* string => string.
  annotation* string => string.

  % Les patrons : ceux des modules chargés par use (aucun : hamac-default).
  accept_experimental.
  service* service {
    replicas? int.                        % remplace celui du service
    consumes* name { provider service. }  % impose le provider
  }
  infrastructure? infrastructure.         % aucune : calculée
}

% ---------------------------------------------------------------------
% Infrastructure
% ---------------------------------------------------------------------

block infrastructure {
  description? string.
  label* string => string.
  annotation* string => string.

  backend backend.

  % Exigences minimales.
  min_nodes? int.
  total_ram? int, size_unit.
  total_cpu? int.

  % Topologie proposée.
  node* name {              % sujet : rôle du nœud
    zone? name.             % la zone qu'il accueille ; défaut : le sujet
    arch? arch.             % défaut amd64
    count? int.             % défaut 1
    ram? int, size_unit.
    cpu? int.
    boot? assurance_level.  % un niveau de l'axe boot
    os_image? string.
    os_sha256? string.
    isolated.
    provisioning_profile? provisioning_profile.
  }
  segment* name {
    cidr string.
    vlan? int.
  }
  % Filtrage entre zones, à états : allow ouvre les connexions d'une zone
  % source vers une zone destination pour le flux déclaré (consommateur,
  % service consommé) qui le justifie ; tout le reste est refusé.
  allow* name, name, service, service.
  deny* name, name.
  deny_reason* name, name => string.

  warning* string.
  certificate? string.
}

enum backend { physical; incus; qemu; kubernetes; docker_compose }.

% ---------------------------------------------------------------------
% Provisioning profile
% ---------------------------------------------------------------------

block provisioning_profile {
  description? string.
  label* string => string.
  annotation* string => string.

  os string {                          % sujet : identifiant logique de l'image
    url string.                        % image de référence
    sha256 string.
    format os_format.
    arch? arch.                        % défaut amd64
    family? name.                      % défaut debian
    raw_zst_url? string.               % dérivés pour l'installation physique
    raw_zst_sha256? string.
    bmap_url? string.
  }
  % Les bundles appliqués, dans l'ordre : leurs cloud-init sont fusionnés
  % dans cet ordre, le suivant l'emportant sur une valeur scalaire.
  bundles* [bundle].
  bundle* bundle {                     % paramètres d'un bundle de bundles
    param* name {
      value? text.                     % paramètre scalaire
      items* [text].                   % paramètre liste
    }
  }
  cloud_init_extra? string.            % cloud-init fusionné, en YAML sur une ligne
  assurance* axis => assurance_level.  % ce qu'offre une machine installée
}

enum os_format { qcow2; raw; iso; netinstall }.

% ---------------------------------------------------------------------
% Bundle
% ---------------------------------------------------------------------

block bundle {
  description? string.
  label* string => string.
  annotation* string => string.

  version? string.       % défaut 0.1.0
  param* name {
    type param_type.
    required.
  }
  depends_on* bundle.
  lifecycle? lifecycle.  % défaut install
}

enum param_type { string; int; bool; list_string; list_int; object }.
enum lifecycle { install; converge }.

% ---------------------------------------------------------------------
% Règles
% ---------------------------------------------------------------------

namespace hamac {
  % Rang des niveaux d'assurance sur leur axe, du plus faible au plus fort :
  % une exigence est satisfaite par un niveau de rang supérieur ou égal.
  assurance_rank boot, none, 0.
  assurance_rank boot, provider_vtpm, 1.
  assurance_rank boot, confidential_vm, 2.
  assurance_rank boot, measured_tpm2, 3.
  assurance_rank operator, any, 0.
  assurance_rank operator, eu, 1.
  assurance_rank operator, secnumcloud, 2.
  assurance_rank operator, self, 3.
  assurance_rank physical, third_party, 0.
  assurance_rank physical, dedicated_rack, 1.
  assurance_rank physical, site, 2.

  % Le provider d'une consommation : le service qu'elle nomme ; pour une
  % capacité, celui que la stack impose, sinon le seul service qui la
  % fournit.
  S.consumes(N).provider(T) :- S.consumes(N).service(T).
  S.consumes(N).provider(P) :-
      S.consumes(N).capability(C),
      K.service(S).consumes(N).provider(P),
      P.capability(C).
  S.consumes(N).provider(P) :-
      S.consumes(N).capability(C),
      not forced(S, N),
      P.capability(C),
      #count { Q : Q.capability(C) } = 1.
  forced(S, N) :- K.service(S).consumes(N).provider(_).

  % Ce que lisent les gabarits d'une consommation : le contrat que remplit
  % son provider, pour la capacité consommée ({~.database.user}, vérifié
  % contre le bloc database : L001 pour un champ qu'il ne déclare pas) ;
  % pour un service, son point d'accès.
  S.consumes(N).database(P) :-
      S.consumes(N).capability(database), S.consumes(N).provider(P), database(P).
  S.consumes(N).cache(P) :-
      S.consumes(N).capability(cache), S.consumes(N).provider(P), cache(P).
  S.consumes(N).host(host(T)) :- S.consumes(N).service(T).
  S.consumes(N).port(Pt) :- S.consumes(N).service(T), first_port(T, Pt).
  first_port(T, Pt) :- service(T), T.port(_), Pt = #min { C : T.port(C) }.

  % Un provider remplit le contrat de sa capacité, et un contrat n'est
  % rempli que par un provider de cette capacité.
  ::error(fmt("[E024] {S} provides the capability database without a database block"),
          S.capability(database)) :-
      S.capability(database), not database(S).
  ::error(fmt("[E024] {S} provides the capability cache without a cache block"),
          S.capability(cache)) :-
      S.capability(cache), not cache(S).
  ::error(fmt("[E024] database block of {P}, which is not a service providing database"),
          database(P)) :-
      database(P), not provider_of(P, database).
  ::error(fmt("[E024] cache block of {P}, which is not a service providing cache"),
          cache(P)) :-
      cache(P), not provider_of(P, cache).
  provider_of(P, C) :- service(P), P.capability(C).

  % Contrôles qui ne lisent qu'un manifeste.
  ::error(fmt("[E013] consumes {N} of {S}: exactly one of capability and service"),
          S.consumes(N)) :-
      S.consumes(N), #count { W : wants(S, N, W) } != 1.
  wants(S, N, capability) :- S.consumes(N).capability(_).
  wants(S, N, service) :- S.consumes(N).service(_).
  ::error(fmt("[E034] secret {N} of {S}: exactly one of ref and generate"),
          S.secret(N)) :-
      S.secret(N), #count { W : source(S, N, W) } != 1.
  source(S, N, ref) :- S.secret(N).ref(_).
  source(S, N, generate) :- S.secret(N).generate(_, _).
  ::error(fmt("[E020] environment {K} of {S} refers to an undeclared secret"),
          S.environment(K, secret(N))) :-
      S.environment(K, secret(N)), not S.secret(N).
  ::error("[E016] replicas must be at least 1", S.replicas(R)) :-
      S.replicas(R), R < 1.
  ::error("[E016] expected 1 <= min_replicas <= max_replicas",
          S.min_replicas(A)) :-
      S.min_replicas(A), S.max_replicas(B), A < 1.
  ::error("[E016] expected 1 <= min_replicas <= max_replicas",
          S.min_replicas(A)) :-
      S.min_replicas(A), S.max_replicas(B), A > B.
  ::error("[E006] min_replicas and max_replicas go together", service(S)) :-
      service(S), #count { W : scaled(S, W) } = 1.
  scaled(S, min) :- S.min_replicas(_).
  scaled(S, max) :- S.max_replicas(_).
  ::error("[E006] readiness interval or timeout without a command",
          service(S)) :-
      readiness_tuned(S), not commanded(S).
  commanded(S) :- S.readiness(_, _).
  readiness_tuned(S) :- S.readiness_interval(_).
  readiness_tuned(S) :- S.readiness_timeout(_).
  ::error(fmt("[E032] size is required for the persistent volume {N}"),
          S.storage(N)) :-
      S.storage(N).class(C), C != ephemeral, not sized(S, N).
  sized(S, N) :- S.storage(N).size(_, _).
  ::error(fmt("[E035] port {P} is not declared by port"),
          S.exposure(H).port(P)) :-
      S.exposure(H).port(P), not S.port(P).
  ::error(fmt("[E006] route {R} of {S} without a zone"), S.route(R)) :-
      S.route(R), not zoned(S).
  zoned(S) :- service(S), S.zone(_).

  % Un niveau d'assurance appartient à son axe.
  ::error(fmt("[E007] {L} is not a level of the axis {A}"),
          P.assurance(Z, A, L)) :-
      pattern(P), P.assurance(Z, A, L), not assurance_level(A, L).
  ::error(fmt("[E007] {L} is not a level of the axis {A}"),
          F.assurance(A, L)) :-
      provisioning_profile(F), F.assurance(A, L), not assurance_level(A, L).
  ::error(fmt("[E007] {L} is not a level of the axis boot"),
          I.node(R).boot(L)) :-
      I.node(R).boot(L), not assurance_level(boot, L).

  % Les champs de placement du vocabulaire, ramenés aux primitives.
  ::separate(S, T) :- service(S), S.anti_affinity(T).
  ::floor(Z, A, L) :- pattern(P), P.assurance(Z, A, L).

  % Zones et flux. La zone d'un service, default s'il n'en déclare pas.
  derived predicate zone_of(service, name).
  zone_of(S, Z) :- service(S), S.zone(Z).
  zone_of(S, default) :- service(S), not S.zone(_).
  defined_zone(Z) :- pattern(P), P.zone(Z).
  ::zone_leq(Z, Z) :- defined_zone(Z).
  ::zone_leq(Z, Z) :- zone_of(_, Z).

  % Dès que les patrons définissent des zones, un service est dans l'une
  % d'elles.
  ::error(fmt("[E042] zone {Z} of {S} is not defined by the patterns"), S.zone(Z)) :-
      service(S), S.zone(Z), defined_zone(_), not defined_zone(Z).

  % Ouvrir une connexion vers un service revient à le lire : le modèle de
  % sécurité doit permettre à la zone du consommateur de lire celle du
  % service consommé. Entre une enclave et une autre zone, rien ne répond :
  % le flux est alors de mode push.
  ::error(fmt("[E040] {S} (zone {ZS}) cannot consume {T} (zone {ZT}): the security model of the patterns does not let zone {ZS} read zone {ZT}; if {T} must expose data to zone {ZS}, have it push them to a service of that zone"),
          S.consumes(N).service(T)) :-
      S.consumes(N).service(T), zone_of(S, ZS), zone_of(T, ZT), not ::zone_leq(ZT, ZS).
  across_diode(ZS, ZT) :- zone_of(_, ZS), zone_of(_, ZT), ZS != ZT, ::enclave(ZS).
  across_diode(ZS, ZT) :- zone_of(_, ZS), zone_of(_, ZT), ZS != ZT, ::enclave(ZT).
  ::error(fmt("[E041] {S} (zone {ZS}) consumes {T} (zone {ZT}) across a diode: nothing can answer a request through it; declare the flow mode push, {T} sending what {S} receives"),
          S.consumes(N).service(T)) :-
      S.consumes(N).service(T), zone_of(S, ZS), zone_of(T, ZT), across_diode(ZS, ZT),
      ::zone_leq(ZT, ZS), not S.consumes(N).mode(push).

  % Architectures. Seule une image OCI peut en couvrir plusieurs ; sans
  % arch, un artefact, un nœud ou une image d'OS est amd64.
  ::error(fmt("[E008] the artifact of {S} is not an OCI image: it runs on exactly one architecture"),
          S.artifact(P)) :-
      S.artifact(P).format(F), F != oci_image, #count { A : S.artifact(P).arch(A) } > 1.
  derived predicate service_arch(service, arch).
  derived predicate node_arch(infrastructure, name, arch).
  derived predicate os_arch(provisioning_profile, arch).
  service_arch(S, A) :- S.artifact(_).arch(A).
  service_arch(S, amd64) :- service(S), not has_arch(S).
  has_arch(S) :- S.artifact(_).arch(_).
  node_arch(I, N, A) :- I.node(N).arch(A).
  node_arch(I, N, amd64) :- I.node(N), not I.node(N).arch(_).
  os_arch(F, A) :- F.os(_).arch(A).
  os_arch(F, amd64) :- F.os(O), not F.os(O).arch(_).

  % Un nœud installé par un profil a l'architecture de son image d'OS.
  ::error(fmt("[E009] node {N} of {I} is {A}, but its profile {F} installs a system for {B}"),
          I.node(N).provisioning_profile(F)) :-
      I.node(N).provisioning_profile(F), node_arch(I, N, A), os_arch(F, B), A != B.

  % L'infrastructure qu'impose une stack offre à chaque service un nœud de
  % sa zone et d'une de ses architectures.
  ::error(fmt("[E046] the infrastructure {I} has no node of the zone of {S} for one of its architectures"),
          K.service(S)) :-
      K.infrastructure(I), K.service(S), not served(I, S).
  served(I, S) :- service_zone_or_default(S, Z), node_zone(I, N, Z),
                  node_arch(I, N, A), service_arch(S, A).
  service_zone_or_default(S, Z) :- service(S), S.zone(Z).
  service_zone_or_default(S, default) :- service(S), not S.zone(_).
  node_zone(I, N, Z) :- I.node(N).zone(Z).
  node_zone(I, N, N) :- I.node(N), not I.node(N).zone(_).

  % Paramètre d'un bundle dans un profil : une valeur ou une liste.
  ::error(fmt("[E007] parameter {X} of the bundle {B}: exactly one of value and items"),
          F.bundle(B).param(X)) :-
      F.bundle(B).param(X), #count { W : shape(F, B, X, W) } != 1.
  shape(F, B, X, value) :- F.bundle(B).param(X).value(_).
  shape(F, B, X, items) :- F.bundle(B).param(X).items(_, _).

  % Un paramètre que le bundle déclare, sous la forme de son type : une
  % liste par items, un scalaire par value ; un objet ne vient que de
  % l'enregistrement de la machine.
  ::error(fmt("[E007] {X} is not a parameter of the bundle {B}"),
          F.bundle(B).param(X)) :-
      F.bundle(B).param(X), not B.param(X).
  ::error(fmt("[E007] parameter {X} of the bundle {B} is a list: give it with items"),
          F.bundle(B).param(X)) :-
      F.bundle(B).param(X).value(_), B.param(X).type(T), list_type(T).
  ::error(fmt("[E007] parameter {X} of the bundle {B} is not a list: give it with value"),
          F.bundle(B).param(X)) :-
      F.bundle(B).param(X).items(_, _), B.param(X).type(T), not list_type(T).
  ::error(fmt("[E007] parameter {X} of the bundle {B} is an object: only the record of the machine gives it"),
          F.bundle(B).param(X)) :-
      F.bundle(B).param(X), B.param(X).type(object).
  ::error(fmt("[E007] parameter {X} of the bundle {B} is a boolean: true or false"),
          F.bundle(B).param(X)) :-
      F.bundle(B).param(X).value(V), B.param(X).type(bool), V != true, V != false.
  list_type(list_string). list_type(list_int).

  % Un bundle s'applique après ceux dont il dépend.
  ::error(fmt("[E012] bundle {B} depends on {D}, which bundles does not list before it"),
          F.bundles(I, B)) :-
      F.bundles(I, B), B.depends_on(D), not listed_before(F, D, I).
  listed_before(F, D, I) :- F.bundles(I, _), F.bundles(J, D), J < I.

  % Les paramètres d'un bundle que le profil n'applique pas.
  ::error(fmt("[E007] parameters of the bundle {B}, which bundles does not list"),
          F.bundle(B)) :-
      F.bundle(B), not applied(F, B).
  applied(F, B) :- F.bundles(_, B).

  % Contrôles d'une stack, quand l'ensemble de fichiers en contient une.
  ::error(fmt("[E023] consumes {N} of {S}: no provider of capability {C}, or several without a choice by the stack"),
          S.consumes(N)) :-
      stack(_), S.consumes(N).capability(C), not S.consumes(N).provider(_).
  ::error(fmt("[E023] the stack forces the provider {P} for {N}, which does not provide {C}"),
          K.service(S).consumes(N).provider(P)) :-
      K.service(S).consumes(N).provider(P),
      S.consumes(N).capability(C),
      not P.capability(C).
  ::error(fmt("[E022] the stack overrides consumes {N}, which {S} does not declare"),
          K.service(S).consumes(N)) :-
      K.service(S).consumes(N), not S.consumes(N).
}
