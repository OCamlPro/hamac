# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
depends: [
  "dune" {>= "3.14"}
  "bos" {build}
  "cmdliner" {build}
  "cohttp-lwt-unix" {build}
  "fmt" {build}
  "fpath" {build}
  "hamac-provisioning" {build}
  "jingoo" {build}
  "logs" {build}
  "lwt" {build}
  "opam-marmiton" {>= "0.1.0" & with-dev-setup}
  "yaml" {build}
  "yojson" {build}
  "ppx_deriving" {build}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]

