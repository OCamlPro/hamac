# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
depends: [
  "dune" {>= "3.14"}
  "dune-site" {build}
  "fmt" {build}
  "loaf" {build}
  "logs" {build}
  "opam-marmiton" {>= "0.1.0" & with-dev-setup}
  "ppx_deriving" {build}
  "ppx_inline_test" {build}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
pin-depends: [
  [ "loaf.0.1.0~beta.2" "git+https://forge.ocamlpro.com/OSS/loaf.git#v0.1.0-beta.2" ]
]
