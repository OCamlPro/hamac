%
% Provider de la capacité cache, dont il remplit le contrat (voir
% postgresql.loaf pour les termes input, instance et consumer).

loaf 0.1.
use hamac 0.2.

service redis {
  runtime http.
  capability cache.
  input password, gen(alnum, 32).
  readiness ["redis-cli", "-a", input(password), "ping"].
  readiness_interval 5.
  readiness_timeout 30.
  environment "REDIS_PASSWORD", input(password).

  artifact "redis:7-alpine@sha256:8da19c7399dca900c6822a1cf30f9d2285585e2c4b457ff4095b0f4500054d3f" {
    sha256 "8da19c7399dca900c6822a1cf30f9d2285585e2c4b457ff4095b0f4500054d3f".
    format oci_image.
  }

  port 6379 { protocol tcp. }
}

cache redis {
  host instance(name).
  port 6379.
  password input(password).
}
