%
% Exemple : une petite application RH, ses zones et ses exigences données
% par un patron, et non par Hamac. La stack charge son patron, un module,
% et nomme ses services : leurs fichiers sont chargés avec elle, ainsi que
% les providers.
%
%   hamac validate examples/hr-stack providers
%
% (depuis la racine du dépôt : le patron est dans ./patterns).

loaf 0.1.
use hamac 0.2.
use exemple_rh 1.0.

stack hr {
  description "Application RH : portail public, API RH, consolidation".
  accept_experimental.

  service portal {}
  service hr_api {}
  service payroll_report {}
}
