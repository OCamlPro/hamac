%
% Un patron d'exemple : les zones de l'organisation, ses modèles de
% sécurité, et les contraintes que la topologie calculée doit satisfaire.
% C'est un module : une stack le charge par « use exemple_rh 1.0. », depuis
% un répertoire de bibliothèque (./patterns par défaut, ou hamac -L DIR).

loaf 0.1.
module exemple_rh 1.0.0.
use hamac 0.2.
use hamac_blp 0.2.
use hamac_rbac 0.2.
use hamac_ha 0.2.

pattern exemple_rh {
  blp::levels [public, internal, confidential].
  blp::category rh; finance.
  rbac::role rh; comptable; admin.

  zone public { blp::level public. }
  zone internal { blp::level internal. }

  zone rh {
    blp::level confidential.
    blp::category rh; finance.
  }

  % Deux zones ne partagent jamais une machine.
  ha::isolate_zones.

  % Un service à état survit à la perte d'un domaine de panne : ses
  % répliques sont de préférence sur au moins trois domaines.
  ha::prefer_stateful_domains 3.
}
