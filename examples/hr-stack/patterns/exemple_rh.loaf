%
% Un patron d'exemple : le treillis de l'organisation, ses zones, et
% quelques contraintes que la topologie calculée doit satisfaire, écrites
% en ASP sur les prédicats que publie le planificateur. C'est un
% module : une stack le charge par « use exemple_rh 1.0. », depuis un
% répertoire de bibliothèque (./patterns par défaut, ou hamac -L DIR).

loaf 0.1.
module exemple_rh 1.0.0.
use hamac 0.2.
use hamac_blp 0.2.
use hamac_rbac 0.2.

pattern exemple_rh {
  blp::levels [public, internal, confidential].
  blp::category rh; finance.
  rbac::role rh; comptable; admin.
  assurance rh, boot, measured_tpm2.
  assurance rh, physical, site.

  zone public { blp::level public. }
  zone internal { blp::level internal. }

  zone rh {
    blp::level confidential.
    blp::category rh; finance.
  }

  constraint one_zone_per_host {
    description "Deux zones ne partagent jamais un noyau".
    violation "H : zone_on(H, Z1), zone_on(H, Z2), Z1 != Z2".
  }

  constraint stateful_quorum {
    description "Un service à état survit à la perte d'un domaine de panne".
    severity soft.
    violation "S : stateful(S), #count { D : on(S, H), failure_domain(H, D) } < 3".
  }

  minimize "1, H : used(H)" { priority 1. }
}
